---
interface Props {
  name: string;
  description: string | null;
  url: string;
  stars: number;
  language: string | null;
  forks: number;
  topics: string[];
}

const { name, description, url, stars, language, forks, topics } = Astro.props;

const languageColors: Record<string, string> = {
  Go: "#00ADD8",
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  Python: "#3572A5",
  Rust: "#dea584",
  Shell: "#89e051",
  HTML: "#e34c26",
  CSS: "#563d7c",
  Dockerfile: "#384d54",
  Makefile: "#427819",
  Nix: "#7e7eff",
};

const langColor = language ? languageColors[language] || "#6b7280" : null;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex flex-col p-3 bg-card border border-black text-black no-underline transition-all duration-150 hover:bg-hover hover:shadow-sharp hover:no-underline"
>
  <div class="flex items-center gap-1.5 mb-1">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="text-muted shrink-0">
      <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"></path>
    </svg>
    <h3 class="text-[15px] font-bold text-accent truncate">{name}</h3>
  </div>

  {description && (
    <p class="text-secondary text-[13px] leading-snug mb-2 line-clamp-2">{description}</p>
  )}

  {topics.length > 0 && (
    <div class="flex flex-wrap gap-1 mb-2">
      {topics.slice(0, 4).map((topic) => (
        <span class="text-[11px] px-1.5 bg-bg text-muted border border-black">{topic}</span>
      ))}
    </div>
  )}

  <div class="flex items-center gap-3 mt-auto pt-2">
    {language && (
      <span class="flex items-center gap-1 text-muted text-xs">
        <span class="w-2.5 h-2.5 inline-block border border-black" style={`background-color: ${langColor}`}></span>
        {language}
      </span>
    )}
    {stars > 0 && (
      <span class="flex items-center gap-1 text-muted text-xs">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="opacity-70">
          <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
        </svg>
        {stars}
      </span>
    )}
    {forks > 0 && (
      <span class="flex items-center gap-1 text-muted text-xs">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="opacity-70">
          <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"></path>
        </svg>
        {forks}
      </span>
    )}
  </div>
</a>
