---
import Logo from "./Logo.astro";

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "projects", match: (p: string) => p === "/" },
  { href: "/about", label: "about", match: (p: string) => p.startsWith("/about") },
];
---

<header class="bg-bg border-b border-line">
  <div class="flex items-center justify-between gap-4 px-6 sm:px-11 py-[18px]">
    <a href="/" class="flex items-center gap-2.5 no-underline shrink-0">
      <Logo size={34} />
      <span class="font-bold text-[16px] text-text leading-none">rakunlabs</span>
      <span class="text-pink font-bold leading-none -ml-1 select-none" aria-hidden="true">▍</span>
    </a>

    <nav class="flex items-center gap-4 sm:gap-5 text-[13px]">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "no-underline transition-colors duration-150",
              link.match(currentPath) ? "text-text" : "text-muted hover:text-text",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://github.com/rakunlabs"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-text no-underline transition-colors duration-150"
      >
        github
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle ml-1"
        aria-label="Toggle dark and light theme"
        title="Toggle theme"
      >
        {/* Lucide moon — shown in dark mode */}
        <svg
          class="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        {/* Lucide sun — shown in light mode */}
        <svg
          class="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

{/* tri-colour brand bar — echoes the logo's three folds */}
<div class="brand-bar" aria-hidden="true">
  <span class="s-pink"></span>
  <span class="s-cream"></span>
  <span class="s-blue"></span>
</div>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    btn.addEventListener("click", function () {
      const light = root.classList.toggle("light");
      try {
        localStorage.setItem("theme", light ? "light" : "dark");
      } catch (e) {}
    });
  })();
</script>
