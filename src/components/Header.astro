---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "projects" },
  { href: "/about", label: "about" },
];
---

<header class="sticky top-0 z-50 bg-bg border-b border-black">
  <div class="max-w-6xl mx-auto px-[5%] flex items-center justify-between h-10">
    <a href="/" class="text-black font-bold text-sm no-underline hover:text-accent transition-colors duration-150">
      rakunlabs
    </a>

    <nav class="hidden sm:flex items-center gap-4 text-[13px]">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "transition-colors duration-150 no-underline",
              currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
                ? "text-accent font-bold"
                : "text-muted hover:text-black",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://github.com/rakunlabs"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-black transition-colors duration-150 flex items-center"
        aria-label="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"></path>
        </svg>
      </a>
    </nav>

    <button
      class="sm:hidden text-muted hover:text-black cursor-pointer bg-transparent border-none p-0"
      aria-label="Toggle menu"
      id="mobile-menu-btn"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="hidden flex-col bg-bg border-b border-black px-[5%] pb-2" id="mobile-nav">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "py-1.5 text-[13px] no-underline",
            currentPath === link.href
              ? "text-accent font-bold"
              : "text-muted hover:text-black",
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="https://github.com/rakunlabs"
      target="_blank"
      rel="noopener noreferrer"
      class="py-1.5 text-[13px] text-muted hover:text-black no-underline"
    >
      github
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const nav = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    nav?.classList.toggle("hidden");
    nav?.classList.toggle("flex");
  });
</script>
