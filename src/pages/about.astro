---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
---

<Layout title="About - rakunlabs" description="Learn about rakunlabs, an open source organization building tools and libraries for the developer community.">
  <div class="max-w-3xl mx-auto px-[5%] py-8 pb-16">
    <section class="text-center mb-8">
      <Logo size={96} class="mx-auto mb-4" />
      <h1 class="inline-block text-2xl font-bold px-3 py-1 bg-accent text-ink border-y border-line">rakunlabs</h1>
      <p class="text-muted text-sm mt-2">Open source projects from the Netherlands</p>
    </section>

    <section class="mb-8">
      <h2 class="text-lg font-bold mb-3 pb-1 border-b border-line">About Us</h2>
      <p class="text-secondary leading-7 mb-3">
        rakunlabs is an open source organization focused on building practical tools and
        libraries for the developer community. Based in the Netherlands, we create software
        that solves real problems and is freely available for everyone to use, modify, and
        contribute to.
      </p>
      <p class="text-secondary leading-7">
        Our projects span across various technologies and domains, with a focus on
        developer experience, performance, and reliability. We believe in the power of
        open source to drive innovation and collaboration.
      </p>
    </section>

    <section class="mb-8">
      <h2 class="text-lg font-bold mb-3 pb-1 border-b border-line">Our Principles</h2>
      <ul class="space-y-1">
        <li class="text-secondary pl-4 border-l-2 border-l-accent">Open source by default — all our projects are publicly available</li>
        <li class="text-secondary pl-4 border-l-2 border-l-accent">Developer experience matters — tools should be intuitive and well-documented</li>
        <li class="text-secondary pl-4 border-l-2 border-l-accent">Quality over quantity — we maintain what we ship</li>
        <li class="text-secondary pl-4 border-l-2 border-l-accent">Community-driven — contributions and feedback are always welcome</li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-lg font-bold mb-3 pb-1 border-b border-line">Get Involved</h2>
      <p class="text-secondary leading-7 mb-3">
        We welcome contributions of all kinds — code, documentation, bug reports, and feature
        requests. Check out our repositories and feel free to open issues or pull requests.
      </p>
      <div class="flex flex-wrap gap-3 mt-3">
        <a
          href="https://github.com/rakunlabs"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 bg-card border border-line text-text text-sm no-underline transition-all duration-150 hover:bg-hover hover:shadow-sharp hover:no-underline"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
          GitHub Organization
        </a>
      </div>
    </section>
  </div>
</Layout>
